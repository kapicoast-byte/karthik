# ---- Slack -------------------------------------------------------------
# Bot token: needed to post DMs, digests and confirmation prompts.
SLACK_BOT_TOKEN=xoxb-...
# User token: REQUIRED to read the user's own DMs (scopes im:history,
# mpim:history, channels:history, groups:history). Needs workspace-admin
# approval. See docs/open-questions.md Q1 - without it, DM capture is out.
SLACK_USER_TOKEN=xoxp-...
SLACK_SIGNING_SECRET=
# Socket Mode avoids exposing a public URL during development.
SLACK_APP_TOKEN=xapp-...
SLACK_USE_SOCKET_MODE=true
# Slack user ID of the person whose work we are tracking (e.g. U01ABCDEF).
SLACK_OWNER_USER_ID=

# Only these channels/DMs are read. Empty = all the token can see.
# Comma-separated channel IDs.
SLACK_CHANNEL_ALLOWLIST=

# ---- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLASSIFIER_MODEL=claude-opus-5

# ---- Plane -------------------------------------------------------------
PLANE_BASE_URL=https://api.plane.so
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=

# ---- Runtime -----------------------------------------------------------
DATABASE_URL=sqlite:///./catalogbot.db
TIMEZONE=Asia/Kolkata
DAILY_DIGEST_CRON=0 8 * * 1-5
FOLLOW_UP_AFTER_DAYS=2
LOG_LEVEL=INFO
